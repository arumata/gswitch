# gswitch systemd user unit
# The daemon runs as the graphical-session user. Device access is granted to
# the active local session by configs/70-gswitch.rules via logind uaccess ACLs.

[Unit]
Description=gswitch - keyboard layout switcher
Documentation=https://github.com/arumata/gswitch
PartOf=graphical-session.target
After=graphical-session.target

# Prevent restart loops: at most 3 starts in 30 seconds.
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/gswitch --run
Restart=on-failure
RestartSec=3

# The process is already unprivileged; these settings reduce what a compromised
# daemon can reach without hiding X11/Wayland sockets or input device nodes.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# wl-copy creates a short-lived temporary directory on some distributions
# (notably Fedora); X11 also needs the host /tmp/.X11-unix socket.
ReadWritePaths=/tmp
PrivateTmp=false
PrivateDevices=false
# Do not add ProtectKernel*/ProtectControlGroups/ProtectClock here. They imply
# capability bounding-set changes which older user managers cannot apply; the
# unprivileged process has no capabilities to begin with.
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=graphical-session.target
