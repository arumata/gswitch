# gswitch udev rules
# Enable access to /dev/uinput for creating virtual keyboard devices
#
# gswitch uses uinput to emit synthetic key events when correcting
# mistyped text. This requires read/write access to /dev/uinput.
#
# Current model (MVP): gswitch runs as root, so these rules are
# primarily for documentation and future non-root operation.
#
# The 'input' group typically has access to /dev/input/* devices.
# Adding uinput to this group allows privileged users in the 'input'
# group to create virtual input devices.

# /dev/uinput - User-level input device creation interface
# MODE=0660 allows owner (root) and group (input) to read/write
# TAG+="uaccess" enables logind-managed access for local sessions
SUBSYSTEM=="misc", KERNEL=="uinput", MODE="0660", GROUP="input", TAG+="uaccess"
