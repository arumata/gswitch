# Example environment file for systemd service: /etc/gswitch/display.env
#
# gswitch (running as a systemd service) needs access to your active graphical session
# to detect layout and/or interact with the clipboard.
#
# Pick the variables appropriate for your desktop session (X11 or Wayland).

# ---- X11 example ----
# DISPLAY=:0
# XAUTHORITY=/home/USER/.Xauthority
# DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# ---- Wayland example ----
# WAYLAND_DISPLAY=wayland-0
# XDG_RUNTIME_DIR=/run/user/1000
# DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

